<div style="width: 100vw; height: 100vh; display: flex; justify-content: center; align-items: center; background: #0f172a; margin: 0;">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%" style="max-width: 500px; max-height: 500px;">
    <!-- 背景の光彩効果 -->
    <defs>
      <radialGradient id="glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/>
      </radialGradient>
      <linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#38bdf8"/>
        <stop offset="100%" stop-color="#818cf8"/>
      </linearGradient>
    </defs>

    <circle cx="200" cy="200" r="150" fill="url(#glow)" />

    <!-- 接続線（アニメーション風のパスやグラデーション） -->
    <g stroke="url(#lineGrad)" stroke-width="4" stroke-linecap="round" fill="none">
      <line x1="200" y1="200" x2="90" y2="110" />
      <line x1="200" y1="200" x2="310" y2="110" />
      <line x1="200" y1="200" x2="90" y2="290" />
      <line x1="200" y1="200" x2="310" y2="290" />
      <line x1="90" y1="110" x2="310" y2="110" opacity="0.4" stroke-dasharray="6 6"/>
      <line x1="90" y1="290" x2="310" y2="290" opacity="0.4" stroke-dasharray="6 6"/>
    </g>

    <!-- 周囲のサブノード -->
    <g fill="#1e293b" stroke="#38bdf8" stroke-width="4">
      <circle cx="90" cy="110" r="24" />
      <circle cx="310" cy="110" r="24" />
      <circle cx="90" cy="290" r="24" />
      <circle cx="310" cy="290" r="24" />
    </g>

    <!-- サブノードの中央の点 -->
    <g fill="#38bdf8">
      <circle cx="90" cy="110" r="8" />
      <circle cx="310" cy="110" r="8" />
      <circle cx="90" cy="290" r="8" />
      <circle cx="310" cy="290" r="8" />
    </g>

    <!-- 中央のメインノード（ハブ） -->
    <circle cx="200" cy="200" r="45" fill="#0f172a" stroke="#38bdf8" stroke-width="6" />
    <circle cx="200" cy="200" r="18" fill="#38bdf8" />
  </svg>
</div>
